# Auto-detect text files and normalize line endings
* text=auto

# Source code files with LF line endings
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.toml text eol=lf

# Windows batch and command scripts
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.jar binary
